# ─── AI Voice Tutor environment variables ──────────────────────────────
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file — it is gitignored by default.

# Google Gemini API key. This MUST be set as a Supabase Edge Function secret
# named GEMINI_API_KEY (not in the frontend). See README → "Gemini API configuration".
GEMINI_API_KEY=

# Silence handling (milliseconds)
SILENCE_TIMEOUT_MS=8000
SECOND_SILENCE_TIMEOUT_MS=10000

# Moderation: how many warnings before the session is ended.
MAX_ABUSIVE_WARNINGS=2

# Supabase (pre-populated by Bolt — do not edit unless you know why)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
